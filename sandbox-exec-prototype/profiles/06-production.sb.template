;; ===========================================================================
;; PRODUCTION PROFILE TEMPLATE — rendered by fleet-common.sh:render_profile()
;; into generated/sbx-agent-N.sb. DO NOT hand-edit the generated file.
;;
;; Placeholders: __HOME__  __VAULT__  __LOGDIR__
;;
;; This is revision 05 with the spike scaffolding removed (no ~/dev access at
;; all) and the fleet log directory added. The revision history below is kept
;; deliberately — most of these rules exist because something specific broke,
;; and several exist because something specific was ESCAPABLE. Read the
;; "DELIBERATELY WITHHELD" block before adding anything to the mach-lookup
;; list.
;;
;; The agent runs with --dangerously-skip-permissions on purpose. That's the
;; whole design: the boundary is the kernel's, not the app's, so it holds even
;; against an operator who talks the agent into disabling its own sandbox.
;; Verified — see NOTES.md, success criterion #3.
;; ===========================================================================
;;
;; --- revision 05 header follows ---
;; Playwright / headless Chromium.
;;
;; PLAN.md called Chromium the hard one and budgeted several iterations. It
;; took three, and the security news is good: headless Chromium runs fine
;; WITHOUT the grants that would have been alarming. It asks for
;; windowserver.active, dock.server, launchservicesd, pasteboard.1,
;; tccd.system and CoreLocation, is denied all six, and degrades gracefully —
;; exit 0, DOM dumped. Those denials are permanent, not TODOs.
;;
;; What it genuinely needed was mundane: exec on the browser binaries,
;; mach-register for its own per-pid IPC rendezvous service, signal delivery
;; to its own children, and a few preference/IOKit reads.
;;
;; --- revision 04 header follows ---
;; Close the LaunchServices confused-deputy hole found by verify.sh against
;; revision 03.
;;
;; Revision 03 passed every filesystem test and both osascript tests, but
;; `open -a Calculator` SUCCEEDED and a real Calculator window appeared on the
;; desktop. `open` doesn't execute the app itself — it asks launchservicesd to,
;; and launchservicesd is outside the sandbox, so the launched app is
;; completely unconfined. That is exactly the confused-deputy escape PLAN.md
;; step 5 warns about: a hostile operator doesn't need file access if it can
;; get an unsandboxed process to act on its behalf. Blocking Apple Events was
;; necessary but not sufficient — LaunchServices is a second, independent path
;; to the same capability.
;;
;; Fixed by removing com.apple.coreservices.launchservicesd and
;; com.apple.lsd.mapdb from the mach-lookup list (both were speculative
;; "probably needed" entries from revision 01, never justified by a denial),
;; plus denying exec of /usr/bin/open as defense in depth.
;;
;; --- original revision 03 header follows ---
;; Add the PLAN.md target allow-list.
;;
;;   Vault    read/write   ~/Library/Mobile Documents/iCloud~md~obsidian/.../Brian's Vault
;;   Bear     READ-ONLY    ~/Library/Group Containers/9K33E3U3T4.net.shinyfrog.bear/Application Data
;;   gcalcli  read/write   ~/.gcalcli   (write: OAuth token refreshes in place)
;;
;; Bear's read-only-ness is enforced twice: it is never granted file-write*,
;; AND an explicit (deny file-write*) covers the whole group container below.
;; The explicit deny is redundant under (deny default) — that is the point. It
;; survives someone later adding a broad write rule above it, because in
;; Seatbelt the LAST matching rule wins.

(version 1)
(deny default)

(import "bsd.sb")

(allow process-fork)
;; `children` as well as `self`: Chromium SIGTERMs its own renderer processes on
;; shutdown, and without this they leak.
;; denial: signal children [headless_shell(30218)] signum:15
;; Still scoped to our own process tree — not (target others).
(allow signal (target self) (target children))
(allow sysctl-read)

;; --- executables -----------------------------------------------------------
(allow process-exec*
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/usr/libexec")
  (subpath "/System")
  (subpath "__HOME__/.local/share/claude")
  (subpath "/opt/homebrew")
  (subpath "__HOME__/.asdf")
  ;; denial: process-exec* ~/.claude/plugins/.../hooks/run-hook.cmd
  (subpath "__HOME__/.claude")
  ;; denial: process-exec* ~/.npm/_npx/.../@playwright/mcp/cli.js
  (subpath "__HOME__/.npm")
  ;; Chromium + headless_shell, installed by playwright.
  (subpath "__HOME__/Library/Caches/ms-playwright"))

(deny process-exec* (with no-log) (literal "/usr/bin/sudo"))

;; Defense in depth for the LaunchServices hole. Removing the mach-lookup is
;; the actual fix; these make the intent explicit and stop the obvious
;; alternate spellings.
(deny process-exec*
  (literal "/usr/bin/open")
  (literal "/usr/bin/osascript")
  (literal "/System/Library/CoreServices/Applications/Directory Utility.app"))

;; --- read-only system ------------------------------------------------------
(allow file-read*
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/usr/libexec")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/opt/homebrew")
  (subpath "__HOME__/.asdf")
  (subpath "/Library/Preferences/Logging")
  (literal "/Library/Preferences/com.apple.networkd.plist")
  ;; denial: file-read-data ~/.tool-versions (asdf version resolution)
  (literal "__HOME__/.tool-versions")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/dtracehelper")
  (literal "/private/etc/hosts")
  (literal "/private/etc/localtime")
  (literal "/private/etc/ssl/cert.pem")
  (literal "/private/etc/protocols")
  (literal "/private/etc/services")
  (literal "/private/etc/passwd"))

(allow file-read-metadata)
(allow file-ioctl (literal "/dev/null"))

;; --- keychain / auth -------------------------------------------------------
(allow file-read* file-write* (subpath "__HOME__/Library/Keychains"))
(allow file-read*
  (subpath "/Library/Keychains")
  (subpath "/System/Library/Keychains")
  ;; denial: security → /private/var/db/mds/messages/501/se_SecurityMessages
  (subpath "/private/var/db/mds"))
(allow user-preference-read
  (preference-domain "com.apple.security")
  (preference-domain "kcfpreferencesanyapplication"))

;; --- tty -------------------------------------------------------------------
(allow file-read* file-write* file-ioctl
  (literal "/dev/tty")
  (regex #"^/dev/ttys[0-9]*$")
  (regex #"^/dev/ptmx$")
  (literal "/dev/stdout")
  (literal "/dev/stderr"))
(allow pseudo-tty)

;; --- Claude Code's own state ----------------------------------------------
(allow file-read* (subpath "__HOME__/.local/share/claude"))
(allow file-read* file-write*
  (subpath "__HOME__/.claude")
  (subpath "__HOME__/.cache/claude")
  (subpath "__HOME__/Library/Caches/claude-cli-nodejs")
  (subpath "__HOME__/.local/state/claude"))
(allow file-read* file-write*
  (regex #"^__HOME__/\.claude\.json(\.|$)"))

;; `literal`, not `subpath` — see revision 02.
(allow file-read* (literal "__HOME__"))
(allow file-read* (literal "__HOME__/.local/bin"))
(allow file-read*
  (literal "__HOME__/.gitconfig")
  ;; denial: file-read-data ~/.gitignore_global
  (literal "__HOME__/.gitignore_global")
  (subpath "__HOME__/.config/git"))

;; ===========================================================================
;; TARGET ALLOW-LIST (PLAN.md)
;; ===========================================================================

;; Vault — read/write. This is the agent's real working directory.
(allow file-read* file-write*
  (subpath "__VAULT__"))

;; Bear — READ ONLY. Note file-read* only; no file-write* anywhere for Bear.
(allow file-read*
  (subpath "__HOME__/Library/Group Containers/9K33E3U3T4.net.shinyfrog.bear/Application Data"))

;; gcalcli — read/write (OAuth token refreshes in place).
(allow file-read* file-write* (subpath "__HOME__/.gcalcli"))

;; npm cache — needed for npx-launched MCP servers.
;; denial: node → file-write-create ~/.npm/_cacache/tmp/...
;; Scoped to ~/.npm specifically. PLAN.md flags this exact denial as one where
;; the tempting fix is a broad (subpath "__HOME__") — that would defeat
;; the profile while still passing every functional check.
(allow file-read* file-write* (subpath "__HOME__/.npm"))

;; --- playwright / chromium -------------------------------------------------
;; Browser binaries and the profile/cache dirs Chromium needs at runtime.
(allow file-read* file-write*
  (subpath "__HOME__/Library/Caches/ms-playwright"))

;; Chromium denials, non-GUI only. See the note below on what's withheld.
;; denial: user-preference-read com.apple.universalaccess
(allow user-preference-read (preference-domain "com.apple.universalaccess"))
;; denial: iokit-open-user-client RootDomainUserClient (power management)
(allow iokit-open-user-client (iokit-user-client-class "RootDomainUserClient"))
;; denial: mach-lookup com.apple.DiskArbitration.diskarbitrationd
(allow mach-lookup (global-name "com.apple.DiskArbitration.diskarbitrationd"))

;; Chromium is multi-process and rendezvouses with its own children over a
;; per-pid mach service it registers itself.
;; denial: mach-register org.chromium.Chromium.MachPortRendezvousServer.29797
;; Scoped by regex to Chromium's own namespace — this lets it talk to its
;; children, not to anything of Apple's.
(allow mach-register
  (global-name-regex #"^org\.chromium\.Chromium\.MachPortRendezvousServer\."))
(allow mach-lookup
  (global-name-regex #"^org\.chromium\.Chromium\.MachPortRendezvousServer\."))

;; denial: file-read-data /private/etc (directory entry)
(allow file-read* (literal "/private/etc"))

;; DELIBERATELY WITHHELD — Chromium asks for these and must run without them:
;;   com.apple.windowserver.active  — WindowServer access. Grants the ability
;;       to interact with the GUI session: read the screen, and in the general
;;       case synthesize input into other applications. That is the same
;;       confused-deputy class as the LaunchServices hole closed in rev 04,
;;       and strictly worse. A headless browser has no business with it.
;;   com.apple.dock.server           — same GUI-session surface.
;;   com.apple.tccd.system           — asking the privacy daemon for grants.
;; If headless Chromium turns out to genuinely require windowserver, that is a
;; finding that belongs in the writeup, not a line quietly added here.

;; --- cloakbrowser / agent-browser ------------------------------------------
;; The browser we actually want for bot-protected sites: CloakBrowser (a
;; Chromium fork with source-level fingerprint patches) driven by the
;; `agent-browser` CLI. Plain fetch/WebFetch handles everything else, so this
;; is the narrow case, not the default.
;;
;; Cheaper to confine than NOTES.md predicted, on two counts:
;;
;;   1. The binary self-installs to ~/.cloakbrowser/chromium-<ver>/Chromium.app
;;      — a single subpath under $HOME, not /Applications. No rule outside the
;;      home directory, and nothing else in the bundle's parent to over-grant.
;;   2. The fork keeps CFBundleIdentifier = org.chromium.Chromium, so its
;;      per-pid rendezvous service lands in the *existing* regex above. No new
;;      mach namespace, no widening.
;;
;; Exec but never write: an agent that can rewrite the browser binary it is
;; about to run has no boundary worth the name.
(allow file-read* process-exec* (subpath "__HOME__/.cloakbrowser"))

;; agent-browser's daemon state: unix socket, config.json, saved auth state.
;; denial: 'Socket directory ~/.agent-browser is not writable' (os error 1)
;; Writable because the socket has to be created here; scoped to the one dir.
;; Note this is where --session-name persists cookies, so treat it as
;; credential-bearing — same care as ~/.gcalcli.
(allow file-read* file-write* (subpath "__HOME__/.agent-browser"))

;; denial: user-preference-read org.chromium.chromium
(allow user-preference-read (preference-domain "org.chromium.chromium"))

;; --- pty launcher ----------------------------------------------------------
;; /usr/bin/python3 is only a shim; the real interpreter and its stdlib live
;; under /Library/Developer/CommandLineTools. Read+exec, never write.
(allow process-exec* (subpath "/Library/Developer/CommandLineTools"))
(allow file-read*    (subpath "/Library/Developer/CommandLineTools"))

;; --- fleet logs ------------------------------------------------------------
;; claude opens its own --debug-file from inside the sandbox, so this must be
;; writable. (launchd's stdout/stderr redirection does NOT need a rule: launchd
;; opens those files itself and passes down the fds, and Seatbelt checks at
;; open() time, not write().)
(allow file-read* file-write* (subpath "__LOGDIR__"))

;; NOTE: the spike scaffolding that revision 05 carried is deliberately gone —
;;   (allow file-read* file-write* .../sandbox-exec-prototype)
;;   (allow file-read*            .../dev/claude-agent)
;; The agent's cwd is the vault, so it never walks up into ~/dev. Nothing in
;; ~/dev is reachable from an agent any more, including this repo. The fleet
;; scripts themselves don't need a rule: launchd runs them unsandboxed, and
;; sandbox-exec reads the profile before the policy applies.

(allow file-read* file-write* (subpath "/private/var/folders"))
(allow file-read* file-write* (subpath "/private/tmp"))

;; --- network ---------------------------------------------------------------
(allow network*)
(allow system-socket)

;; --- mach ------------------------------------------------------------------
;; Named list. Deliberately absent: com.apple.appleevents /
;; com.apple.coreservices.appleevents — that pairing is what would let
;; osascript drive Mail/Finder as a confused deputy (PLAN.md phase 1 step 5).
(allow mach-lookup
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.diagnosticd")
  (global-name "com.apple.logd")
  (global-name "com.apple.logd.events")
  (global-name "com.apple.system.DirectoryService.libinfo_v1")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.dnssd.service")
  (global-name "com.apple.nehelper")
  (global-name "com.apple.networkd")
  (global-name "com.apple.usymptomsd")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.FSEvents")
  ;; denial: node → mach-lookup com.apple.SystemConfiguration.DNSConfiguration
  (global-name "com.apple.SystemConfiguration.DNSConfiguration"))

;; REMOVED in revision 04 — these are the LaunchServices escape:
;;   com.apple.coreservices.launchservicesd
;;   com.apple.lsd.mapdb
;; Re-adding either one re-opens `open -a <anything>`. If some tool later
;; genuinely needs LaunchServices, that needs its own decision, not a
;; quiet re-add to fix a denial.

(allow ipc-posix-shm)

;; ===========================================================================
;; BACKSTOPS — last match wins, so these override anything granted above.
;; ===========================================================================

;; Bear is read-only, permanently. Covers the entire group container, not just
;; Application Data.
(deny file-write*
  (subpath "__HOME__/Library/Group Containers/9K33E3U3T4.net.shinyfrog.bear"))

;; Credentials and keys that nothing in the target allow-list needs. Explicit
;; so that a future broad rule can't silently expose them.
(deny file-read* file-write*
  (subpath "__HOME__/.ssh")
  (subpath "__HOME__/.aws")
  (subpath "__HOME__/.gnupg"))
