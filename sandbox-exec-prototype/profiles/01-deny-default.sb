;; Phase 1, revision 01 — start from fully restricted.
;;
;; Goal of this revision: get the process to *start at all* under
;; (deny default). No vault, no Bear, no gcalcli yet — those get added
;; deliberately in later revisions so denial noise stays attributable.

(version 1)
(deny default)

;; Basic BSD syscall surface (sysctl, signals, fcntl, ...).
(import "bsd.sb")

(allow process-fork)
(allow signal (target self))
(allow sysctl-read)

;; --- executables -----------------------------------------------------------
;; System binaries plus Claude Code itself. NOT a blanket allow: exec is
;; scoped to these roots, so the sandbox can't be escaped by exec'ing
;; something the agent wrote into the vault.
(allow process-exec*
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/usr/libexec")
  (subpath "/System")
  (subpath "/Users/brianlow/.local/share/claude"))

;; --- read-only system ------------------------------------------------------
(allow file-read*
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/usr/libexec")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/Library/Preferences/Logging")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/dtracehelper")
  (literal "/private/etc/hosts")
  (literal "/private/etc/localtime")
  (literal "/private/etc/ssl/cert.pem")
  (literal "/private/etc/protocols")
  (literal "/private/etc/services")
  (literal "/private/etc/passwd"))

;; Path resolution needs to stat intermediate dirs it can't otherwise read.
(allow file-read-metadata)

;; --- tty -------------------------------------------------------------------
;; `script -q /dev/null` allocates a pty; the TUI needs to read and write it.
(allow file-read* file-write* file-ioctl
  (literal "/dev/tty")
  (regex #"^/dev/ttys[0-9]*$")
  (regex #"^/dev/ptmx$")
  (literal "/dev/stdout")
  (literal "/dev/stderr"))
(allow pseudo-tty)

;; --- Claude Code's own state ----------------------------------------------
(allow file-read* (subpath "/Users/brianlow/.local/share/claude"))
(allow file-read* file-write*
  (subpath "/Users/brianlow/.claude")
  (literal "/Users/brianlow/.claude.json")
  (literal "/Users/brianlow/.claude.json.backup")
  (subpath "/Users/brianlow/.cache/claude")
  (subpath "/Users/brianlow/Library/Caches/claude-cli-nodejs"))

;; --- working dir -----------------------------------------------------------
;; Scratch only for now. The vault replaces this in a later revision.
(allow file-read* file-write*
  (subpath "/Users/brianlow/dev/claude-agent/sandbox-exec-prototype/scratch")
  (subpath "/Users/brianlow/dev/claude-agent/sandbox-exec-prototype/logs"))

;; Temp.
(allow file-read* file-write* (subpath "/private/var/folders"))
(allow file-read* file-write* (subpath "/private/tmp"))

;; --- network ---------------------------------------------------------------
;; Wide open for now. Phase 2 is where this gets interrogated.
(allow network*)
(allow system-socket)

;; --- mach ------------------------------------------------------------------
;; Deliberately a named list rather than (allow mach-lookup): unrestricted
;; mach-lookup is the confused-deputy hole the plan's step-5 IPC test is
;; about. Anything added here needs a reason.
(allow mach-lookup
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.diagnosticd")
  (global-name "com.apple.logd")
  (global-name "com.apple.logd.events")
  (global-name "com.apple.system.DirectoryService.libinfo_v1")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.dnssd.service")
  (global-name "com.apple.nehelper")
  (global-name "com.apple.networkd")
  (global-name "com.apple.usymptomsd")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.lsd.mapdb"))

(allow ipc-posix-shm)
