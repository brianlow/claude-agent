;; ===========================================================================
;; BROWSER PROFILE TEMPLATE — rendered by fleet-common.sh:render_browser_profile()
;; into generated/sbx-browser.sb. DO NOT hand-edit the generated file.
;;
;; Placeholders: __HOME__  __VAULT__  __LOGDIR__
;;
;; This is the *second* sandbox in a split design. It exists because
;; CloakBrowser cannot run inside the agent's profile at all:
;;
;;   abort() called
;;   HIServices  ___RegisterApplication_block_invoke
;;   HIServices  TransformProcessType
;;   Chromium Framework  ChromeMain
;;
;; TransformProcessType is a LaunchServices call, and LaunchServices is exactly
;; the mach-lookup that revision 04 REMOVED to close the `open -a` confused-
;; deputy escape. Playwright's headless_shell tolerated that denial; the full
;; Chromium.app treats it as fatal, and CloakBrowser ships only the full
;; bundle (the C++ fingerprint patches ARE the browser — there is no headless
;; shell variant to fall back to). Granting it back got further and then
;; SIGSEGV'd in -[NSWindow _close] with WindowServer denied.
;;
;; So the two capability sets are irreconcilable in one profile, and the answer
;; is to keep them in two:
;;
;;   agent profile   vault + Bear + Keychain + gcalcli,   NO GUI, NO LaunchServices
;;   browser profile GUI + LaunchServices,                NO secrets whatsoever
;;
;; The agent reaches the browser only over localhost CDP. CDP has no verb that
;; spawns a process, so what a hostile session operator gets here is page-level
;; control, not host code execution.
;;
;; READ THIS BEFORE ADDING ANYTHING: the security value of this file is
;; entirely in what it does NOT grant. It holds the GUI/LaunchServices surface,
;; which means a Chromium exploit landing here can launch unconfined GUI apps.
;; That is an accepted, deliberate cost — see NOTES.md. It is only acceptable
;; because there is nothing of value in reach. Every grant added below must be
;; checked against that sentence.
;; ===========================================================================

(version 1)
(deny default)

(import "bsd.sb")

(allow process-fork)
;; Chromium SIGTERMs its own renderers on shutdown; without this they leak,
;; which matters for a browser that stays up for days. Own tree only.
(allow signal (target self) (target children))
(allow sysctl-read)

;; Full internet. Same decision as the agent profile (PLAN.md Phase 2 was
;; descoped deliberately): this browser exists to fetch the public web.
(allow network*)

;; --- executables -----------------------------------------------------------
(allow process-exec*
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/usr/libexec")
  (subpath "/System")
  (subpath "/Library/Developer/CommandLineTools")
  ;; The browser bundle itself, plus its Helper apps
  ;; (Chromium Helper (GPU|Renderer|Alerts|Plugin).app, crashpad handler).
  ;; Read+exec, never write: an agent that can rewrite the browser binary it is
  ;; about to run has no boundary worth the name.
  (subpath "__HOME__/.cloakbrowser"))

;; Defense in depth. This profile DOES hold launchservicesd, so unlike the
;; agent profile these denies are load-bearing rather than belt-and-braces:
;; they are what stops the obvious spellings of "ask LaunchServices to start
;; an unconfined app for me".
(deny process-exec*
  (literal "/usr/bin/open")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/sudo"))

;; --- read-only system ------------------------------------------------------
(allow file-read*
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/usr/libexec")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/Library/Developer/CommandLineTools")
  (subpath "/Library/Preferences/Logging")
  (literal "/Library/Preferences/com.apple.networkd.plist")
  ;; denial: file-read-data /Library/Input Methods, /Library/Keyboard Layouts
  (subpath "/Library/Input Methods")
  (subpath "/Library/Keyboard Layouts")
  (subpath "/Library/Fonts")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/private/etc")
  (literal "/private/etc/hosts")
  (literal "/private/etc/localtime")
  (literal "/private/etc/ssl/cert.pem")
  (literal "/private/etc/protocols")
  (literal "/private/etc/services")
  (literal "/private/etc/passwd"))

;; Deliberately NOT the global (allow file-read-metadata) the agent profile
;; carries. NOTES.md flags that as a real enumeration leak (every filename and
;; project name on the machine) accepted there for path resolution. A browser
;; needs to resolve far less, so the leak is not re-accepted here.
(allow file-read-metadata
  (subpath "__HOME__/.cloakbrowser")
  (subpath "__LOGDIR__/browser")
  (subpath "/private/var/folders")
  (subpath "/System")
  (subpath "/usr")
  (subpath "/Library")
  (literal "/")
  (literal "__HOME__"))

(allow file-ioctl (literal "/dev/null"))

;; --- browser binary + its data dir -----------------------------------------
(allow file-read* (subpath "__HOME__/.cloakbrowser"))

;; The browser's --user-data-dir (Chromium calls this a "profile"; unrelated to
;; the Seatbelt profile this file is). Cookies and logged-in sessions live
;; here, so treat it as credential-bearing: it is the one place in this sandbox
;; that accumulates anything worth stealing.
(allow file-read* file-write* (subpath "__LOGDIR__/browser"))

;; Temp. /private/var/folders is where Chromium puts its code-sign clone.
;; file-link as well as file-write*: modern Chromium on macOS clonefile()s its
;; own bundle into .../X/org.chromium.Chromium.code_sign_clone/ at startup, and
;; a plain write grant is not enough —
;; denial: forbidden-link-priv<file-write*> .../code_sign_clone/...
(allow file-read* file-write* (subpath "/private/var/folders"))
(allow file-link (subpath "/private/var/folders"))
(allow file-read* file-write* (subpath "/private/tmp"))

;; --- GUI session -----------------------------------------------------------
;; THE COST OF THIS PROFILE. Everything here is withheld from the agent
;; profile on purpose, and is granted here only because CloakBrowser does not
;; start without it. Do not copy these lines back into the agent profile.
;;
;; windowserver.active — GUI session access. In the general case this permits
;;   reading the screen and synthesizing input into other apps. Required:
;;   without it the browser SIGSEGVs in -[NSWindow _close] even under
;;   --headless, because the full Chromium.app does real AppKit window work.
;; launchservicesd — required: TransformProcessType abort()s without it.
;;   This is the rev-04 escape, re-granted knowingly, in a sandbox that holds
;;   no secrets and cannot exec /usr/bin/open.
(allow mach-lookup
  (global-name "com.apple.windowserver.active")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.lsd.mapdb")
  (global-name "com.apple.CoreServices.coreservicesd")
  (global-name "com.apple.distributed_notifications@Uv3")
  (global-name "com.apple.DiskArbitration.diskarbitrationd")
  (global-name "com.apple.system.opendirectoryd.api")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.fonts")
  (global-name "com.apple.FontObjectsServer")
  (global-name "com.apple.audio.AudioComponentRegistrar")
  (global-name "com.apple.audio.audiohald"))

;; Chromium's own IPC. Both namespaces are needed and both are Chromium's own:
;;   org.chromium.Chromium.MachPortRendezvousServer.<pid>  (rev 05, headless_shell)
;;   org.chromium.Chromium.apps.<hash>                     (new — full app only)
;; denial: bootstrap_check_in org.chromium.Chromium.apps.997B8E...: Permission denied (1100)
;; The fork keeps CFBundleIdentifier = org.chromium.Chromium, so one regex over
;; Chromium's own namespace covers both. It grants nothing of Apple's.
(allow mach-register mach-lookup
  (global-name-regex #"^org\.chromium\.Chromium\."))

;; GPU. Without these WebGL has no context, and "no WebGL" is itself a
;; fingerprint tell — which would defeat the entire point of an anti-detect
;; browser. Granting GPU access is a rendering capability, not a data one.
(allow iokit-open-user-client
  (iokit-user-client-class "IOSurfaceRootUserClient")
  (iokit-user-client-class "AGXDeviceUserClient")
  (iokit-user-client-class "IOAccelDevice")
  (iokit-user-client-class "IOAccelSharedUserClient")
  (iokit-user-client-class "IOAccelContext")
  (iokit-user-client-class "IOAccelCommandQueue")
  (iokit-user-client-class "RootDomainUserClient"))

(allow iokit-get-properties)

(allow user-preference-read
  (preference-domain "org.chromium.chromium")
  (preference-domain "com.apple.universalaccess")
  (preference-domain "kCFPreferencesAnyApplication")
  (preference-domain ".GlobalPreferences"))

;; --- STILL WITHHELD, even here ---------------------------------------------
;; Granting the GUI surface is not a licence to grant everything GUI-adjacent.
;; These stay denied and the browser runs fine without them:
;;   com.apple.pasteboard.1        — clipboard read. A direct path to whatever
;;                                   the user last copied, from a process that
;;                                   renders hostile web content. Never.
;;   com.apple.tccd(.system)       — asking the privacy daemon for grants.
;;   com.apple.CoreLocation.agent  — location.
;;   com.apple.bird / bird.token   — iCloud Drive access.
;;   com.apple.backupd.sandbox.xpc — Time Machine.
;;   com.apple.metadata.mds,
;;   com.apple.spotlight.IndexAgent — Spotlight: a metadata query service is an
;;                                   enumeration path around the filesystem
;;                                   rules below.

;; ===========================================================================
;; EXPLICIT DENIES — the point of this file
;; ===========================================================================
;; Content reads are already denied by (deny default). These are restated
;; because in Seatbelt the LAST matching rule wins, so they survive someone
;; later adding a broad allow above them — and because a reader needs to be
;; able to see, in one place, that the GUI-privileged sandbox holds nothing.
;;
;; file-read-metadata is listed SEPARATELY and deliberately. It is not covered
;; by file-read* — verified, and it is not intuitive:
;;
;;   (deny file-read* (subpath "<vault>"))   →  ls -l <vault>/CLAUDE.md  SUCCEEDS
;;   (deny file-read-metadata (subpath ...)) →  ls -l ...  Operation not permitted
;;
;; `(import "bsd.sb")` grants file-read-metadata broadly, and a later
;; (deny file-read*) does not take it back. Without the explicit operation
;; named here, this sandbox could stat and enumerate the vault — filenames,
;; sizes, mtimes — while being unable to read a byte of content. That is a
;; smaller leak than content, but it is not nothing, and the agent profile
;; still carries it globally (NOTES.md records that as accepted for path
;; resolution). It is NOT re-accepted here.
(deny file* file-read-metadata
  (subpath "__VAULT__")
  (subpath "__HOME__/Library/Mobile Documents")
  (subpath "__HOME__/Library/Group Containers/9K33E3U3T4.net.shinyfrog.bear")
  (subpath "__HOME__/Library/Keychains")
  (subpath "/Library/Keychains")
  (subpath "__HOME__/Library/Messages")
  (subpath "__HOME__/.gcalcli")
  (subpath "__HOME__/.ssh")
  (subpath "__HOME__/.claude")
  (subpath "__HOME__/.aws")
  (subpath "__HOME__/.config")
  (subpath "__HOME__/dev")
  (subpath "__HOME__/Documents")
  (subpath "__HOME__/Desktop"))
